[Unit]
Description=Gunicorn instance to serve family-tree backend
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/root/family-tree/backend
Environment="PATH=/usr/bin"
EnvironmentFile=/root/family-tree/backend/.env
ExecStart=/usr/local/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app --bind 127.0.0.1:8080

[Install]
WantedBy=multi-user.target
